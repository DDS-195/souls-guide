PORT=3000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_USER=souls_guide_app
DB_PASSWORD=CHANGE_ME
DB_NAME=souls_guide
JWT_SECRET=CHANGE_ME_at_least_32_random_characters
# 用于匿名访客标识的单向哈希；生产环境应使用与 JWT_SECRET 不同的随机值。
ANALYTICS_SALT=CHANGE_ME_another_random_secret
ADMIN_USERNAME=admin
# 首次创建管理员时临时设置；要求 12~72 位且包含大小写、数字和特殊字符。
ADMIN_INITIAL_PASSWORD=
LOG_RETENTION_DAYS=30
# 以下配置用于生产的一跳 Nginx + HTTPS 拓扑；示例域名必须替换。
TRUST_PROXY_HOPS=1
PUBLIC_ORIGIN=https://your-domain.invalid
SITE_HOST=your-domain.invalid
MIN_UPLOAD_FREE_MB=2048
