# Docker Compose 环境变量。复制为 .env 后替换所有 CHANGE_ME 值；.env 已被 Git 忽略。
MYSQL_ROOT_PASSWORD=CHANGE_ME_database_root_password
MYSQL_USER=souls_guide_app
MYSQL_PASSWORD=CHANGE_ME_application_database_password
JWT_SECRET=CHANGE_ME_at_least_32_random_characters
ANALYTICS_SALT=CHANGE_ME_another_random_secret
ADMIN_USERNAME=admin
# 仅首次创建管理员或替换历史 admin123 时使用；成功启动后应从部署环境中移除。
ADMIN_INITIAL_PASSWORD=CHANGE_ME_12_chars_with_Aa1!
LOG_RETENTION_DAYS=30
PUBLIC_ORIGIN=https://your-domain.invalid
SITE_HOST=your-domain.invalid
MIN_UPLOAD_FREE_MB=2048

# 生产 HTTPS 证书放入 nginx/certs/fullchain.pem 与 nginx/certs/privkey.pem。
